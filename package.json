    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "js-yaml": "^5.5.0",
    "mitt": "^3.0.1",
    "node-bump-version": "^3.1.0",
    "npm": "12.2.3",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "postcss": "^8.5.33",
    "postcss-html": "^2.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qrcode.vue": "^3.11.1",
    "stylelint": "^18.1.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^19.1.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^41.1.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "stylelint-order": "^8.1.3",
