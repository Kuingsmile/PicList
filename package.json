{
  "name": "piclist",
  "version": "3.6.1",
  "private": true,
  "description": "A powerful cloud storage manage tool.",
  "homepage": "https://piclist.cn",
  "bugs": {
    "url": "https://github.com/Kuingsmile/PicList/issues",
    "email": "pkukuing@gmail.com"
  },
  "license": "MIT",
  "author": {
    "name": "Kuingsmile",
    "email": "pkukuing@gmail.com"
