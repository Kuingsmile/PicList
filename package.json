    "tunnel": "^0.0.6",
    "upyun": "^3.4.6",
    "uuid": "^14.0.3",
    "vue": "^3.5.46",
    "webdav": "^5.11.0",
    "write-file-atomic": "^8.0.0",
    "yaml": "^2.9.1"
  },
