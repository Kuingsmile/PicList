+// process can corrupt GLib state. Use Sharp's official Wasm build in Electron
+// only, and let a missing Wasm dependency fail rather than retry native loading.
+let sharp = process.versions.electron && runtimePlatform.startsWith("linux")
+  ? require("@img/sharp-wasm32/sharp.node")
+  : undefined;
 const errors = [];
-try {
